import fastf1
import matplotlib.pyplot as plt

print("rodando...")

session = fastf1.get_session(2023, 'Monza', 'R')
session.load()

laps = session.laps.pick_drivers('LEC')

plt.plot(laps['LapTime'].dt.total_seconds().reset_index(drop=True))

plt.title("Leclerc - Monza 2023")
plt.xlabel("Voltas")
plt.ylabel("Tempo (s)")
plt.grid()

plt.show()
